# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Oracle Cloud Infrastructure Parameters
# Compartment ID (defaults to root tenancy OCID if left empty)
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..aaaaaaaaza6oyygqwfsvdxg4qmm5txf4nncp2x7y5y45q53fe4qaof4uwp4q

# Target Subnet ID (Required for instance launch)
OCI_SUBNET_ID=

# Canonical Ubuntu Minimal aarch64 Image OCID (Optional: if empty, script will fetch automatically)
OCI_IMAGE_ID=

# SSH Public Key string (Optional: if empty, /ssh/authorized_keys file will be used)
OCI_SSH_PUBLIC_KEY=
